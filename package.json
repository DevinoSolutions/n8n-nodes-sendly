{
	"name": "n8n-nodes-sendly",
	"version": "0.1.0",
	"description": "n8n community node for Sendly: send transactional emails and campaigns, add or update contacts and list members, and start workflows on email and contact events.",
	"license": "MIT",
	"homepage": "https://github.com/DevinoSolutions/n8n-nodes-sendly#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"sendly",
		"email",
		"transactional-email",
		"email-marketing",
		"newsletter",
		"contacts"
	],
	"author": {
		"name": "Devino Solutions",
		"email": "support@sendly.now",
		"url": "https://sendly.now"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DevinoSolutions/n8n-nodes-sendly.git"
	},
	"bugs": {
		"url": "https://github.com/DevinoSolutions/n8n-nodes-sendly/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "tsc -p tsconfig.test.json && vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo",
		"!dist/**/*.map"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SendlyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Sendly/Sendly.node.js",
			"dist/nodes/SendlyTrigger/SendlyTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^22.0.0",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
